---
import { sitePath } from '../lib/site-path';

type GalleryItem = {
  src: string;
  alt: string;
  caption: string;
};

interface Props {
  items: GalleryItem[];
}

const { items } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<div class="project-gallery">
  {items.map((item) => (
    <figure>
      <img src={sitePath(item.src, base)} alt={item.alt} width="1600" height="1000" loading="lazy" />
      <figcaption>{item.caption}</figcaption>
    </figure>
  ))}
</div>
