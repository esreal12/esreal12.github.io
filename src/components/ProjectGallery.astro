---
type GalleryItem = {
  src: string;
  alt: string;
  caption: string;
};

interface Props {
  items: GalleryItem[];
}

const { items } = Astro.props;
---

<div class="project-gallery">
  {items.map((item) => (
    <figure>
      <img src={item.src} alt={item.alt} width="1600" height="1000" loading="lazy" />
      <figcaption>{item.caption}</figcaption>
    </figure>
  ))}
</div>
