---
import { LOCALES, switchLocalePath, type Locale } from '../lib/locale';
import { sitePath } from '../lib/site-path';

interface Props {
  locale: Locale;
  currentPath: string;
  knownSlugs?: string[];
}

const { locale, currentPath, knownSlugs = [] } = Astro.props;
const knownProjectSlugs = new Set(knownSlugs);
const base = import.meta.env.BASE_URL;
---

<nav class="language-switcher" aria-label="Language">
  {LOCALES.map((targetLocale) => (
    <a
      href={sitePath(switchLocalePath(currentPath, targetLocale, knownProjectSlugs), base)}
      aria-current={targetLocale === locale ? 'page' : undefined}
    >
      {targetLocale.toUpperCase()}
    </a>
  ))}
</nav>
