---
import '../styles/global.css';
import { profile } from '../data/profile';
import { type Locale } from '../lib/locale';
import { buildSeo } from '../lib/seo';
import { sitePath } from '../lib/site-path';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  canonicalPath: string;
  imagePath?: string;
}

const { locale, title, description, canonicalPath, imagePath } = Astro.props;
const base = import.meta.env.BASE_URL;
const seo = buildSeo({ locale, title, description, canonicalPath, imagePath, origin: Astro.site, base });
const currentPath = base === '/'
  ? Astro.url.pathname
  : `/${Astro.url.pathname.slice(base.length).replace(/^\/+/, '')}`;
const copy = profile.locales[locale];
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={seo.description} />
    <link rel="icon" href={sitePath('/favicon.svg', base)} type="image/svg+xml" />
    <link rel="canonical" href={seo.canonicalUrl} />
    <link rel="alternate" hreflang={locale} href={seo.canonicalUrl} />
    <link rel="alternate" hreflang={seo.alternateLocale} href={seo.alternateUrl} />
    <link rel="alternate" hreflang="x-default" href={seo.defaultLocaleUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={seo.localeCode} />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:url" content={seo.canonicalUrl} />
    <meta property="og:image" content={seo.imageUrl} />
    <meta property="og:image:alt" content={seo.title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seo.title} />
    <meta name="twitter:description" content={seo.description} />
    <meta name="twitter:image" content={seo.imageUrl} />
    <title>{seo.title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">{copy.skipLink}</a>
    <SiteHeader locale={locale} currentPath={currentPath} />
    <main id="main-content">
      <slot />
    </main>
    <SiteFooter locale={locale} />
    <script>
      import '../scripts/motion';
    </script>
  </body>
</html>
