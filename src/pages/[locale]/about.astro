---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { profile } from '../../data/profile';
import { isLocale, LOCALES } from '../../lib/locale';
import { sitePath } from '../../lib/site-path';
export function getStaticPaths() { return LOCALES.map((locale) => ({ params: { locale } })); }
const value = Astro.params.locale ?? '';
if (!isLocale(value)) return new Response(null, { status: 404 });
const locale = value;
const copy = profile.locales[locale].about;
const base = import.meta.env.BASE_URL;
---
<BaseLayout locale={locale} title={copy.title} description={copy.description} canonicalPath={`/${locale}/about/`}>
  <article class="about-page container">
    <div class="about-portrait">
      <img src={sitePath('/images/profile/andres-israel-umana-sedo.png', base)} alt={copy.imageAlt} width="1024" height="1536" />
    </div>
    <div class="about-copy">
      <p class="eyebrow">{copy.description}</p>
      <h1>{copy.title}</h1>
      <p>{copy.body}</p>
      <a class="primary-action" href={sitePath('/documents/andres-israel-umana-sedo-cv.pdf', base)} download>{copy.downloadCv}</a>
    </div>
  </article>
</BaseLayout>
