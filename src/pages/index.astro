---
import { sitePath } from '../lib/site-path';

const target = sitePath('/en/', import.meta.env.BASE_URL);
const canonical = new URL(target, Astro.site ?? Astro.url).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={canonical} />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <title>Andrés Israel Umaña Sedó — Digital Work</title>
    <style is:inline>
      html,
      body {
        margin: 0;
        min-height: 100%;
        background: #f5f3eb;
      }
    </style>
    <script define:vars={{ target }}>
      window.location.replace(target);
    </script>
  </head>
  <body></body>
</html>
