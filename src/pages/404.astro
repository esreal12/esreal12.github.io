---
import '../styles/global.css';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex" />
    <title>Página no encontrada / Page not found</title>
  </head>
  <body>
    <main class="not-found container">
      <section lang="es">
        <p class="eyebrow">404</p>
        <h1>Página no encontrada</h1>
        <p>El enlace no lleva a un proyecto publicado. Puedes volver a la selección de trabajo.</p>
        <a href="/es/work/">Explorar proyectos</a>
      </section>
      <section lang="en">
        <p class="eyebrow">404</p>
        <h2>Page not found</h2>
        <p>This link does not lead to a published project. You can return to the selected work.</p>
        <a href="/en/work/">Explore work</a>
      </section>
    </main>
  </body>
</html>
