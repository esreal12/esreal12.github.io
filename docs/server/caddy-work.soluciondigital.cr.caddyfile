work.soluciondigital.cr {
  root * /var/www/work.soluciondigital.cr
  encode zstd gzip

  @fingerprintedAssets path /_astro/*
  header @fingerprintedAssets Cache-Control "public, max-age=31536000, immutable"

  try_files {path} {path}/ =404
  file_server

  handle_errors {
    @notFound expression {http.error.status_code} == 404
    rewrite @notFound /404.html
    file_server
  }
}
